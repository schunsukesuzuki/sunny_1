+import json
+
+def load_input(input_path):
+    with open(input_path, 'r') as f:
+        return json.load(f)
+
+def save_output(output_path, output_data):
+    with open(output_path, 'w') as f:
+        json.dump(output_data, f, indent=2)
+
+def is_skill_match(case, reviewer):
+    return case['required_skill'] in reviewer['skills']
+
+def can_assign_case(case, reviewer, day):
+    # Check if reviewer has capacity for this day
+    if day >= len(reviewer['daily_capacity_hours']):
+        return False
+    
+    capacity = reviewer['daily_capacity_hours'][day]
+    if capacity < case['duration_hours']:
+        return False
+    
+    return True
+
+def assign_case_to_reviewer(case, reviewer, day):
+    # Check if we can assign this case to this reviewer on this day
+    if not is_skill_match(case, reviewer):
+        return None
+    
+    if not can_assign_case(case, reviewer, day):
+        return None
+    
+    return {
+        'case_id': case['case_id'],
+        'reviewer_id': reviewer['reviewer_id'],
+        'day': day,
+        'hours': case['duration_hours']
+    }
+
+def find_best_assignment(case, reviewers, days):
+    # Find the best reviewer for this case based on deadline priority
+    # and skill scarcity
+    
+    # First, we need to check which reviewers are qualified
+    qualified_reviewers = [r for r in reviewers if is_skill_match(case, r)]
+    
+    if not qualified_reviewers:
+        return None
+    
+    # Sort by deadline priority (earlier deadlines first)
+    qualified_reviewers.sort(key=lambda r: sum(1 for d in range(days) if can_assign_case(case, r, d)))
+    
+    # Try to assign to the best reviewer
+    for day in range(days):
+        for reviewer in qualified_reviewers:
+            assignment = assign_case_to_reviewer(case, reviewer, day)
+            if assignment:
+                return assignment
+    
+    return None
+
+def solve(input_data):
+    days = input_data['days']
+    cases = input_data['cases']
+    reviewers = input_data['reviewers']
+    
+    assignments = []
+    unassigned_case_ids = []
+    
+    # Keep track of reviewer capacity
+    reviewer_capacity = {}
+    for reviewer in reviewers:
+        reviewer_capacity[reviewer['reviewer_id']] = [h for h in reviewer['daily_capacity_hours']]
+    
+    # Sort cases by deadline priority (earlier deadlines first)
+    sorted_cases = sorted(cases, key=lambda c: c['deadline_day'])
+    
+    for case in sorted_cases:
+        best_assignment = find_best_assignment(case, reviewers, days)
+        
+        if best_assignment:
+            # Update reviewer capacity
+            reviewer_id = best_assignment['reviewer_id']
+            day = best_assignment['day']
+            hours = best_assignment['hours']
+            
+            reviewer_capacity[reviewer_id][day] -= hours
+            assignments.append(best_assignment)
+        else:
+            unassigned_case_ids.append(case['case_id'])
+    
+    return {
+        'assignments': assignments,
+        'unassigned_case_ids': unassigned_case_ids
+    }
+
+if __name__ == '__main__':
+    input_data = load_input('/home/user/input.json')
+    result = solve(input_data)
+    save_output('/home/user/output.json', result)