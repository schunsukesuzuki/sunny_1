+import json
+from collections import defaultdict
+
+def load_input(input_path):
+    with open(input_path, 'r') as f:
+        return json.load(f)
+
+def save_output(output_path, output_data):
+    with open(output_path, 'w') as f:
+        json.dump(output_data, f, indent=2)
+
+def is_skill_match(case_skill, reviewer_skills):
+    return case_skill in reviewer_skills
+
+def assign_cases(input_data):
+    days = input_data['days']
+    cases = input_data['cases']
+    reviewers = input_data['reviewers']
+    
+    # Initialize data structures
+    assignments = []
+    unassigned_case_ids = []
+    reviewer_capacity = defaultdict(lambda: [0] * days)
+    
+    # Sort cases by deadline (EDD - Earliest Deadline First)
+    sorted_cases = sorted(cases, key=lambda x: x['deadline_day'])
+    
+    for case in sorted_cases:
+        case_id = case['case_id']
+        required_skill = case['required_skill']
+        duration_hours = case['duration_hours']
+        deadline_day = case['deadline_day']
+        
+        assigned = False
+        
+        # Find a suitable reviewer
+        for reviewer in reviewers:
+            reviewer_id = reviewer['reviewer_id']
+            reviewer_skills = reviewer['skills']
+            daily_capacity = reviewer['daily_capacity_hours']
+            
+            if not is_skill_match(required_skill, reviewer_skills):
+                continue
+            
+            # Try to assign the case to this reviewer
+            for day in range(days):
+                if day > deadline_day:
+                    break  # Skip days beyond deadline
+                
+                if (reviewer_capacity[reviewer_id][day] + duration_hours <= daily_capacity[day]):
+                    # Assign case to this reviewer on this day
+                    reviewer_capacity[reviewer_id][day] += duration_hours
+                    assignments.append({
+                        'case_id': case_id,
+                        'reviewer_id': reviewer_id,
+                        'day': day,
+                        'hours': duration_hours
+                    })
+                    assigned = True
+                    break
+            
+            if assigned:
+                break
+        
+        if not assigned:
+            unassigned_case_ids.append(case_id)
+    
+    return {'assignments': assignments, 'unassigned_case_ids': unassigned_case_ids}
+
+if __name__ == '__main__':
+    input_data = load_input('/home/user/input.json')
+    output_data = assign_cases(input_data)
+    save_output('/home/user/output.json', output_data)